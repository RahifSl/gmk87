{
  "name": "gmk87-master-control-center",
  "description": "Zuoya GMK87 desktop and WebHID studio for VIA keymap editing, 240x135 RGB565 TFT LCD flashing, RTC sync, and 19-mode underglow control.",
  "author": "Zuoya GMK87 Community Studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx local-server.ts",
    "vite:dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:electron": "vite build && node scripts/build-electron.mjs",
    "desktop": "npm run build:electron && electron .",
    "desktop:hidden": "npm run build:electron && electron . --hidden",
    "package:win": "npm run build:electron && electron-builder --win --x64",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron release server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "node-hid": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "lucide-react": "^0.546.0",
    "omggif": "^1.0.10",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
